# LLM provider config for the AI Portfolio backend.
# Preference order at startup: OpenRouter -> Groq -> local fallback.
# Copy this file to `.env` and fill in a real key. Never commit `.env`.

# --- OpenRouter (preferred) ---
OPENROUTER_API_KEY=your_openrouter_key_here
# Optional: override the default chat model.
# Comma-separated fallback list: free models share rate-limited upstream pools,
# so the backend tries each in order before dropping to the local responder.
OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2:free,openai/gpt-oss-20b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free

# --- Groq (used only if OPENROUTER_API_KEY is unset) ---
# GROQ_API_KEY=your_groq_key_here
